# wx-obsidian Web 服务（容器）的运行时环境
#
#   cp deploy/wx-obsidian/.env.example deploy/wx-obsidian/.env
#
# 这个 env_file 只管容器进程内的开关。**端口范围与来源放行**由项目级环境给
# （compose 的 ${...} 插值只读项目根的 .env 或命令行），见 docker-compose.yml：
#
#   WX_WEB_BIND=0.0.0.0 docker compose up -d      # 发布到局域网（默认 127.0.0.1）
#   WX_ALLOW_REMOTE=0   docker compose up -d      # 关掉来源放行（容器里通常必须为 1）
#   WX_WEB_PORT=8766    docker compose up -d      # 换宿主端口
#
# 提醒：真正决定「谁能访问」的是宿主端口绑定；一旦 WX_WEB_BIND=0.0.0.0，
# 凭据就只剩 URL 里那条明文 token，共享网段上优先考虑 Tailscale / SSH 隧道
# （docs/design-docs/web-ui/docker.md §5）。

# 固定访问令牌。留空 = 每次启动随机生成 —— 那样每次重启收藏的 URL 都会失效，
# 容器会重启，所以长期运行请设一个：openssl rand -base64 24
WX_WEB_TOKEN=
