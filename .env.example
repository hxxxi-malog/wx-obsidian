# DeepSeek API 配置（LLM 与 Vision 默认共用这一个 Key）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash 同时支持文本与图像输入，默认语言模型与视觉模型都用它
MODEL_NAME=deepseek-flash

# 可选的独立视觉渠道（默认与 LLM 共用 DEEPSEEK_API_KEY，一般无需修改）
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL_NAME=deepseek-flash
MAX_VISION_CONCURRENCY=10
VISION_TIMEOUT=120
VISION_MAX_RETRIES=2

# 文章数据源（当前仅支持 we-mp-rss）；也可在 ~/.wx-obsidian/config.json 的 source.type 配置
WX_SOURCE=we_mp_rss

# 调试模式（设为 1 开启，会保存 API 原始响应到 last_response.txt）
DEBUG=0
