# 环境变量（含密钥）
# .env 的精确匹配盖不住备份文件，而备份里同样有密钥，故一并忽略
.env
.env.bak.*
.env.*.bak

# 运行时数据
processed.json
last_response.txt

# 日志
logs/

# Python
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 备份文件
config.yaml.bak.*

# Docker 数据卷
data/

# we-mp-rss 部署：凭据与运行时数据不入库
# （config.yaml 只含 ${VAR} 引用，可以入库）
deploy/we-mp-rss/.env
deploy/we-mp-rss/data/

# macOS
.DS_Store

# 本地开发文档与 Claude Code 配置
docs/
.claude/
