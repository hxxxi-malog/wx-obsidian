# 环境变量（含密钥）
# .env 的精确匹配盖不住备份文件，而备份里同样有密钥，故一并忽略
.env
.env.bak.*
.env.*.bak

# 运行时数据
processed.json
last_response.txt

# 日志
logs/

# Python
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Web 前端：依赖与构建产物（static/ 由 pnpm build 生成，FastAPI 托管）
node_modules/
wx_obsidian/web/static/
# pnpm 包存储（在本仓库时会落到根目录，体积可达数百 MB）
.pnpm-store/

# 打包
.build-venv/
# 3.12 兼容性验证用的独立 venv（T-15a：与 3.9 dev venv 对照跑门禁）
.venv312/
build/
dist/

# 备份文件
config.yaml.bak.*

# Docker 数据卷
data/

# we-mp-rss 部署：凭据与运行时数据不入库
# （config.yaml 只含 ${VAR} 引用，可以入库）
deploy/we-mp-rss/.env
deploy/we-mp-rss/data/

# wx-obsidian 容器部署：令牌等运行期开关不入库（.env.example 入库）
deploy/wx-obsidian/.env

# macOS
.DS_Store

# 本地开发文档与 Agent 工具配置
docs/
.claude/
.agents/
